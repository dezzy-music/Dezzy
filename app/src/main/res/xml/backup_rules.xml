<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <exclude
        domain="file"
        path="./exoplayer" />
    <exclude
        domain="file"
        path="./download" />
    <exclude
        domain="database"
        path="exoplayer_internal.db" />
    <!-- DataStore holds session tokens (Supabase, YouTube, Discord); never back it up -->
    <exclude
        domain="file"
        path="./datastore" />
</full-backup-content>