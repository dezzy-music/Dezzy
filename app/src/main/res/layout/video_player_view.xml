<?xml version="1.0" encoding="utf-8"?>
<!--
  Superficie de video del modo video. TextureView (no SurfaceView) para que se pueda
  rotar y escalar con graphicsLayer: la pantalla completa gira la capa 90° en vez de
  rotar la Activity, y la ventanita flotante de "Solo videos" la encoge.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:resize_mode="fit"
    app:shutter_background_color="@android:color/black"
    app:surface_type="texture_view"
    app:use_controller="false" />
